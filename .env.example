# Django
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de donnees (PostgreSQL via le docker-compose du workspace)
POSTGRES_DB=bamfa
POSTGRES_USER=bamfa
POSTGRES_PASSWORD=bamfa
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# CORS / CSRF (origine du frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Cookies d'authentification (JWT httpOnly)
# AUTH_COOKIE_SECURE=True et AUTH_COOKIE_SAMESITE=None en production HTTPS cross-site
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

# Signature JWT (optionnel : par defaut = DJANGO_SECRET_KEY)
# Definir une cle dediee (>=32 caracteres) pour pouvoir la roter independamment.
# JWT_SIGNING_KEY=

# Email — dev : console (defaut). Pour brancher un vrai SMTP en dev
# (MailHog/Mailpit local, Mailtrap, etc.), mettre :
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=BAMFA <no-reply@bamfa.org>
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Paiement (manuel maintenant ; FedaPay/Kkiapay plus tard)
PAYMENT_PROVIDER=apps.payments.providers.ManualPaymentProvider
